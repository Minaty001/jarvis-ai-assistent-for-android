# Groq API key for LLM and STT (primary provider — get one free at https://console.groq.com)
GROQ_API_KEY=
# Groq model to use (default: llama-3.1-8b-instant)
MODEL_NAME=llama-3.1-8b-instant
# OpenAI API key (fallback LLM provider — used when Groq is unavailable)
# OPENAI_API_KEY=
# OpenAI model to use for fallback (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# Wake words (comma-separated)
WAKE_WORDS=jarvis,boss,computer
# Audio sample rate
SAMPLE_RATE=16000
# Listen timeout in seconds
LISTEN_TIMEOUT=5.0
# Groq API timeout
GROQ_TIMEOUT=30.0
# Max conversation history turns
MAX_HISTORY=20
# LLM temperature (0.0-2.0, lower = more deterministic)
# LLM_TEMPERATURE=0.7
# LLM max tokens per response
# LLM_MAX_TOKENS=512
# TTS rate and pitch (termux-tts-speak)
TTS_RATE=175
TTS_PITCH=100
