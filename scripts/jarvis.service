[Unit]
Description=Jarvis AI Assistant Web UI Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/saifali/jarvis-ai-assistent-for-android
ExecStart=/home/saifali/jarvis-ai-assistent-for-android/.venv/bin/python -m jarvis --web --no-voice
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
